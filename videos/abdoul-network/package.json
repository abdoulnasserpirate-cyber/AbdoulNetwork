{
  "name": "abdoul-network",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "transcribe": "node scripts/transcribe.mjs",
    "transcribe:offline": "python3 scripts/transcribe_sherpa.py models/sherpa-onnx-whisper-medium models/sherpa-onnx-streaming-zipformer-fr-2023-04-14",
    "music": "python3 scripts/make_music.py 39.2",
    "render": "remotion render AbdoulNetwork out/abdoul-network.mp4",
    "postrender": "ffmpeg -y -loglevel error -i out/abdoul-network.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -c:a aac -b:a 192k -movflags +faststart out/final.mp4 && mv out/final.mp4 out/abdoul-network.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/fonts": "^4.0.535",
    "@remotion/install-whisper-cpp": "^4.0.535",
    "@remotion/media": "^4.0.535",
    "@remotion/media-utils": "^4.0.535",
    "@remotion/paths": "^4.0.535",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "typescript": "^5.8.3"
  }
}
