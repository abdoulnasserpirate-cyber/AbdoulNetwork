{
 "segments": [
  {
   "s": 0.09,
   "e": 2.12,
   "text": "Tu vends des produits, mais tes publications ne font aucune"
  },
  {
   "s": 2.21,
   "e": 2.79,
   "text": "vue ?"
  },
  {
   "s": 3.42,
   "e": 8.12,
   "text": "Avec une seule photo de ton produit, l'intelligence artificielle peut te créer une vraie vidéo pub."
  },
  {
   "s": 8.58,
   "e": 9.53,
   "text": "Pas besoin de caméra,"
  },
  {
   "s": 9.64,
   "e": 10.77,
   "text": "pas besoin de monteur."
  },
  {
   "s": 11.18,
   "e": 11.64,
   "text": "Étape un :"
  },
  {
   "s": 12.21,
   "e": 15.19,
   "text": "télécharge l'application Kling AI et crée ton compte."
  },
  {
   "s": 15.68,
   "e": 16.86,
   "text": "Tu as des crédits gratuits"
  },
  {
   "s": 16.97,
   "e": 17.6,
   "text": "pour commencer."
  },
  {
   "s": 18.04,
   "e": 18.6,
   "text": "Étape deux :"
  },
  {
   "s": 18.95,
   "e": 19.58,
   "text": "appuie sur"
  },
  {
   "s": 19.78,
   "e": 20.94,
   "text": "« Image vers vidéo »"
  },
  {
   "s": 21.26,
   "e": 22.7,
   "text": "et ajoute la photo de ton produit."
  },
  {
   "s": 23.38,
   "e": 24.5,
   "text": "Prends une photo nette,"
  },
  {
   "s": 24.72,
   "e": 25.88,
   "text": "avec un fond propre."
  },
  {
   "s": 26.39,
   "e": 27.79,
   "text": "C'est ça qui fait la différence."
  },
  {
   "s": 28.21,
   "e": 28.87,
   "text": "Étape trois,"
  },
  {
   "s": 29.18,
   "e": 30.31,
   "text": "la plus importante :"
  },
  {
   "s": 30.58,
   "e": 32.17,
   "text": "décris le mouvement que tu veux."
  },
  {
   "s": 32.93,
   "e": 33.57,
   "text": "Par exemple :"
  },
  {
   "s": 33.8,
   "e": 35.89,
   "text": "le produit tourne lentement sur lui-même,"
  },
  {
   "s": 36.45,
   "e": 37.46,
   "text": "lumière de studio,"
  },
  {
   "s": 38.1,
   "e": 38.67,
   "text": "gouttes d'eau"
  },
  {
   "s": 38.91,
   "e": 39.96,
   "text": "qui tombent autour,"
  },
  {
   "s": 40.48,
   "e": 41.08,
   "text": "style"
  },
  {
   "s": 41.19,
   "e": 42.42,
   "text": "publicité de luxe."
  },
  {
   "s": 42.87,
   "e": 43.85,
   "text": "Tu lances la génération…"
  },
  {
   "s": 44.32,
   "e": 45.36,
   "text": "et regarde le résultat."
  },
  {
   "s": 45.88,
   "e": 48.0,
   "text": "Ta simple photo est devenue une vidéo pub."
  },
  {
   "s": 48.54,
   "e": 49.16,
   "text": "Étape quatre :"
  },
  {
   "s": 49.46,
   "e": 50.34,
   "text": "ajoute ton prix,"
  },
  {
   "s": 50.48,
   "e": 51.51,
   "text": "ton numéro WhatsApp"
  },
  {
   "s": 51.73,
   "e": 53.02,
   "text": "et une musique dans CapCut."
  },
  {
   "s": 53.45,
   "e": 54.45,
   "text": "C'est prêt à poster."
  },
  {
   "s": 55.03,
   "e": 56.04,
   "text": "Et si tu maîtrises ça,"
  },
  {
   "s": 56.12,
   "e": 58.36,
   "text": "tu peux même le vendre aux commerçants autour de toi."
  },
  {
   "s": 59.15,
   "e": 59.53,
   "text": "Écris"
  },
  {
   "s": 59.61,
   "e": 60.17,
   "text": "« VIDÉO » en commentaire"
  },
  {
   "s": 60.46,
   "e": 62.69,
   "text": "pour d'autres astuces comme celle-ci."
  },
  {
   "s": 63.52,
   "e": 64.69,
   "text": "Enregistre cette vidéo,"
  },
  {
   "s": 64.84,
   "e": 65.51,
   "text": "et abonne-toi."
  }
 ],
